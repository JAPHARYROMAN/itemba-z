# Server-only URL for the Go core API. Never expose this with NEXT_PUBLIC_*.
ITEMBA_API_BASE_URL=http://localhost:8080

# ITEMBA deployment security mode. Only the exact value "development" may use
# explicit development identity headers. Staging/production require OIDC.
ITEMBA_ENV=development
ITEMBA_OIDC_COOKIE_NAME=itemba_oidc_access_token
ITEMBA_CONTROL_CENTER_ORIGIN=http://localhost:3000

# Production OIDC browser-session lifecycle. These values are intentionally
# unset for the local development-identity path. The first encryption key is
# active for writes; retained keys after the first are decrypt-only rotation
# keys. Never commit real client secrets or encryption keys.
# ITEMBA_OIDC_ISSUER_URL=https://identity.example.com/tenant
# ITEMBA_OIDC_CLIENT_ID=itemba-control-center
# ITEMBA_OIDC_CLIENT_SECRET=load-from-secret-manager
# ITEMBA_OIDC_CLIENT_AUTH_METHOD=client_secret_basic
# ITEMBA_OIDC_SCOPES=openid profile email offline_access
# ITEMBA_OIDC_AUDIENCE=itemba-core-api
# ITEMBA_SESSION_ENCRYPTION_KEYS=2026-08:REPLACE_WITH_32_BYTE_BASE64URL_KEY
# ITEMBA_OIDC_SESSION_COOKIE_NAME=itemba_oidc_session
# ITEMBA_OIDC_TRANSACTION_COOKIE_NAME=itemba_oidc_transaction
# ITEMBA_SESSION_IDLE_TIMEOUT_SECONDS=1800
# ITEMBA_SESSION_ABSOLUTE_TIMEOUT_SECONDS=28800
# ITEMBA_OIDC_AUTH_MAX_AGE_SECONDS=28800
# ITEMBA_SESSION_REFRESH_LEEWAY_SECONDS=90
# ITEMBA_OIDC_TRANSACTION_TIMEOUT_SECONDS=600

# Local development only. Use IDs seeded in your local core API database.
ITEMBA_DEV_IDENTITY_ENABLED=true
ITEMBA_DEV_TENANT_ID=00000000-0000-4000-8000-000000000001
ITEMBA_DEV_COMPANY_ID=00000000-0000-4000-8000-000000000002
ITEMBA_DEV_BRANCH_ID=00000000-0000-4000-8000-000000000003
ITEMBA_DEV_WAREHOUSE_ID=00000000-0000-4000-8000-000000000004
ITEMBA_DEV_ACTOR_ID=00000000-0000-4000-8000-000000000005
