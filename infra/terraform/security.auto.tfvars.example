# Provider identifiers only. Do not place real credentials or private keys here.
secret_custody = {
  provider                 = "APPROVED_PROVIDER"
  vault_id                 = "secret-manager-resource-id"
  encryption_key_id        = "managed-kms-key-id"
  certificate_manager_id   = "managed-certificate-resource-id"
  audit_log_destination_id = "immutable-security-log-destination"
  rotation_owner           = "APPROVED_SECURITY_OWNER"
  emergency_access_group   = "APPROVED_BREAK_GLASS_GROUP"
}

runtime_secret_references = {
  api_database_url        = "secretref://api/database-url"
  worker_database_url     = "secretref://worker/database-url"
  oidc_client_secret      = "secretref://control-center/oidc-client-secret"
  session_encryption_keys = "secretref://control-center/session-encryption-key-ring"
  object_storage_key      = "secretref://api/object-storage-key"
}

deployment_safety = {
  managed_tls                        = true
  private_networking                 = true
  managed_postgresql                 = true
  encrypted_object_storage           = true
  redis_is_non_authoritative          = true
  least_privilege_runtime_identities = true
  point_in_time_recovery              = true
  immutable_backup_copy               = true
  development_seed_disabled           = true
  header_identity_disabled            = true
  unsafe_debug_disabled               = true
}
