POSTGRES_DB=itemba_z
POSTGRES_USER=itemba_z
POSTGRES_PASSWORD=replace-with-a-local-only-password
POSTGRES_HOST_PORT=5432
POSTGRES_API_RUNTIME_USER=itemba_z_api_runtime
POSTGRES_API_RUNTIME_PASSWORD=replace-with-a-distinct-api-runtime-password
POSTGRES_WORKER_RUNTIME_USER=itemba_z_worker_runtime
POSTGRES_WORKER_RUNTIME_PASSWORD=replace-with-a-distinct-worker-runtime-password
MINIO_ROOT_USER=itemba_z_local
MINIO_ROOT_PASSWORD=replace-with-a-local-only-password

# Stable, non-secret identities created by the development-only seed command.
ITEMBA_DEV_TENANT_ID=00000000-0000-4000-8000-000000000001
ITEMBA_DEV_COMPANY_ID=00000000-0000-4000-8000-000000000002
ITEMBA_DEV_BRANCH_ID=00000000-0000-4000-8000-000000000003
ITEMBA_DEV_WAREHOUSE_ID=00000000-0000-4000-8000-000000000004
ITEMBA_DEV_ACTOR_ID=00000000-0000-4000-8000-000000000005
