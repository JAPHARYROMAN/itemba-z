{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.itemba-z.example/events/event-envelope.v1.schema.json",
  "title": "ITEMBA-Z domain event envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "occurred_at",
    "tenant_id",
    "legal_company_id",
    "aggregate_type",
    "aggregate_id",
    "actor_id",
    "correlation_id",
    "payload"
  ],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "type": "string", "pattern": "^[a-z][a-z0-9_.]+$" },
    "event_version": { "type": "integer", "minimum": 1 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "tenant_id": { "type": "string", "format": "uuid" },
    "legal_company_id": { "type": "string", "format": "uuid" },
    "branch_id": { "type": ["string", "null"], "format": "uuid" },
    "aggregate_type": { "type": "string", "minLength": 1 },
    "aggregate_id": { "type": "string", "format": "uuid" },
    "actor_id": { "type": "string", "format": "uuid" },
    "correlation_id": { "type": "string", "format": "uuid" },
    "causation_id": { "type": ["string", "null"], "format": "uuid" },
    "classification": {
      "type": "string",
      "enum": ["public", "internal", "confidential", "restricted"],
      "default": "internal"
    },
    "payload": { "type": "object" },
    "metadata": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  }
}
